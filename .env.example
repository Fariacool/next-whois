# Docker Compose deployment. The defaults work without Redis or Moz credentials.
IMAGE_NAME=ghcr.io/fariacool/next-whois:latest
HOST_BIND_ADDRESS=0.0.0.0
HOST_PORT=3000
TZ=UTC
COMPOSE_NETWORK_NAME=next-whois
RESTART_POLICY=unless-stopped
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Optional Bearer key for /api/lookup and /api/og. Empty = public access.
API_KEY=

# Optional Moz integration.
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# Optional external Redis cache. Empty REDIS_HOST disables caching.
# For Redis on the Docker host, use host.docker.internal with a reachable listener.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# This file configures container runtime values, not the image build.
# NEXT_PUBLIC_* browser/site settings require a custom build.
